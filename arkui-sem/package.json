{
  "name": "arkui-sem",
  "version": "0.2.0",
  "private": true,
  "description": "ArkTS/ArkUI semantic lint for the coding-agent loop, as an opencode plugin",
  "type": "module",
  "main": "dist/opencode.js",
  "exports": {
    ".": "./dist/opencode.js"
  },
  "bin": {
    "arkui-sem": "dist/cli.js"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p .",
    "typecheck": "node node_modules/typescript/bin/tsc -p . --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run typecheck && node --import tsx --test \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "check:fixtures": "node dist/cli.js check test/fixtures --format agent",
    "install:project": "node scripts/install.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@typesafe-ai/sdk": "^0.6.0",
    "json5": "^2.2.3",
    "ohos-typescript": "4.9.5-r10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
